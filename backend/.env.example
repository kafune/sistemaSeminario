# Copie para .env e ajuste. NUNCA commite o .env real.
TOV_DB_HOST=127.0.0.1
TOV_DB_PORT=3306
TOV_DB_USER=root
TOV_DB_PASSWORD=
TOV_DB_NAME=tov
# Senha do root do MySQL no docker-compose (diferente da senha da aplicação).
TOV_DB_ROOT_PASSWORD=
TOV_SECRET_KEY=gere-uma-chave-aleatoria-grande-aqui
# Cifra o token da instância do WhatsApp guardado no banco. Vazia, usa a
# TOV_SECRET_KEY — mas assim rotacionar o JWT derruba a integração.
TOV_ENCRYPTION_KEY=gere-mais-uma-chave-aleatoria-grande-aqui
# Duração da sessão (minutos). Padrão: 12 horas.
TOV_TOKEN_EXPIRE_MINUTES=720
TOV_GOOGLE_FORMS_WEBHOOK_SECRET=gere-outra-chave-aleatoria-grande-aqui
# Segredo do webhook do banco/PSP que avisa PIX e boletos recebidos.
# Vazio desliga a integração: a conciliação continua por lançamento manual.
TOV_BANCO_WEBHOOK_SECRET=
TOV_CORS_ORIGINS=http://localhost:5173
TOV_UAZAPI_BASE_URL=https://seu-subdominio.uazapi.com
TOV_UAZAPI_ADMIN_TOKEN=cole-o-admintoken-aqui
TOV_WHATSAPP_DELAY_MIN=5
TOV_WHATSAPP_DELAY_MAX=15
TOV_WHATSAPP_UPLOAD_MAX_MB=20
TOV_MATERIAIS_UPLOAD_MAX_MB=25
TOV_WHATSAPP_MASS_MAX_RECIPIENTS=1000
TOV_PUBLIC_API_URL=https://seu-dominio.com/api
# Web Push (gere o par com `npx web-push generate-vapid-keys`). Vazios desligam o push.
TOV_VAPID_PUBLIC_KEY=
TOV_VAPID_PRIVATE_KEY=
TOV_VAPID_SUBJECT=mailto:contato@seu-dominio.com
# Fuso da instituição: decide "hoje" para vencimentos e chamadas.
TOV_TIMEZONE=America/Sao_Paulo
# Reparo de integridade acadêmica (apaga vínculos órfãos e duplicatas) a cada
# boot: 0 desliga. Rode deliberadamente com `python -m app.reparar --aplicar`.
TOV_REPARO_INTEGRIDADE_NO_BOOT=0
